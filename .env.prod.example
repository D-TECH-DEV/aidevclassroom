# ==============================================================================
# Environnement PRODUCTION — Exemple de configuration (.env.prod.example)
# Copier vers .env.prod sur le VPS (CE FICHIER NE DOIT JAMAIS ÊTRE VERSIONNÉ)
# ==============================================================================

COMPOSE_PROJECT_NAME=aidev-prod

# ── Domaines et Ports Reverse Proxy ───────────────────────────────────────────
# Remplacer par vos véritables noms de domaine configurés dans vos DNS
DOMAIN_NAME=classroom.votre-domaine.com
API_DOMAIN_NAME=api.classroom.votre-domaine.com

# Ports d'écoute Nginx sur l'hôte VPS
HTTP_PORT=80
HTTPS_PORT=443

# ── Backend NestJS ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Connexion PostgreSQL Externe (Existant sur le VPS)
# IMPORTANT : Utilisez un compte dédié avec privilèges stricts (voir deploy/database-setup.md)
# Exemples :
# - Si PostgreSQL tourne sur l'hôte Ubuntu (non dockerisé) : host.docker.internal ou IP passerelle Docker (172.17.0.1)
# - Si PostgreSQL tourne dans un conteneur sur le réseau Docker externe du VPS : nom DNS du conteneur PG
DATABASE_URL="postgresql://aidev_user:MOT_DE_PASSE_TRES_FORT@IP_OU_DNS_PG_VPS:5432/aidev_db?schema=public"

# Authentification JWT (Générer avec : openssl rand -base64 48)
JWT_SECRET="CLE_SECRETE_PRODUCTION_OBLIGATOIRE_MINIMUM_32_CARACTERES"
JWT_EXPIRES_IN="8h"

# Paystack (Clés LIVE de production uniquement)
# Ne JAMAIS utiliser de clé sk_test_ en production
PAYSTACK_SECRET_KEY="sk_live_votre_cle_secrete_live_paystack"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="https://classroom.votre-domaine.com/paiement/retour"
PAYSTACK_CURRENCY="XOF"

# CORS : Origine exacte du frontend de production
FRONTEND_URL="https://classroom.votre-domaine.com"

# Swagger Documentation (désactivé en production pour des raisons de sécurité)
SWAGGER_ENABLED=false

# ── Frontend Next.js ──────────────────────────────────────────────────────────
# URL de l'API publique appelée par le frontend
NEXT_PUBLIC_API_URL="https://api.classroom.votre-domaine.com/api/v1"
