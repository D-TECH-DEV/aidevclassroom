# ==============================================================================
# Environnement DEV — Exemple de configuration (.env.dev.example)
# Copier vers .env.dev pour l'environnement local de développement
# ==============================================================================

COMPOSE_PROJECT_NAME=aidev-dev

# ── Ports Hôte (Machine Locale) ───────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ── Backend NestJS ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1



# Connexion à la base PostgreSQL externe (ex: sur votre machine hôte ou serveur de dev)
# Remplacer <pg-host>, <user>, <password>, <port>, <database> par vos identifiants réels
DATABASE_URL="postgresql://dev_user:dev_password@host.docker.internal:5432/aidev_dev?schema=public"

# Authentification JWT (au moins 32 caractères requis)
JWT_SECRET="dev_jwt_secret_must_be_at_least_32_characters_long_random"
JWT_EXPIRES_IN="24h"

# Paystack (Clés de test uniquement en développement)
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_test_secret_key"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="http://localhost:3000/paiement/retour"
PAYSTACK_CURRENCY="XOF"
# Canal Charge mobile money direct (mtn, orange, wave), sans carte.
# Desactive par defaut cote code (ancien flux checkout) ; "true" debite sans
# redirection. Ne debite que si un provider mobile money est fourni.
PAYSTACK_CHARGE_ENABLED="true"
PAYSTACK_CHARGE_PROVIDERS="mtn,orange,wave"
# Duree (minutes) de reservation d'un PENDING ; au-dela, ABANDONED.
PAYSTACK_PENDING_RESERVE_MINUTES="120"
PAYSTACK_CHARGE_POLL_TIMEOUT_MS="180000"
PAYSTACK_CHARGE_POLL_INTERVAL_MS="5000"
PAYSTACK_FAILED_SHORT_CIRCUIT_MINUTES="15"
PAYSTACK_HTTP_TIMEOUT_MS="15000"

# CORS : Origine autorisée du frontend en dev
FRONTEND_URL="http://localhost:3000"

# Swagger Documentation (activé en dev sur /api/docs)
SWAGGER_ENABLED=true

# Compte Admin initial (optionnel, pour prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@aidev.local"
SEED_ADMIN_NAME="Dev Admin"
SEED_ADMIN_PASSWORD="DevPassword123!"

# ── Frontend Next.js ──────────────────────────────────────────────────────────
# URL de l'API appelée par le frontend (en dev direct : backend exposé sur BACKEND_PORT)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# Bascule du parcours direct (charge mobile money, sans carte) : actif sauf
# "0" (repli ancien parcours checkout). Bascule auto si le back rend une
# authorizationUrl (charge desactivee cote serveur).
NEXT_PUBLIC_PAYSTACK_CHARGE_ENABLED="1"
