# ==============================================================================
# Environnement PRODUCTION COOLIFY — Exemple (.env.coolify.example)
# Variables à renseigner dans Coolify (Environment Variables)
# ==============================================================================

# ── Base de données PostgreSQL (service postgres inclus dans compose.coolify.yml)
POSTGRES_USER=aidev_user
POSTGRES_PASSWORD="MOT_DE_PASSE_POSTGRES_TRES_FORT"
POSTGRES_DB=aidev_db
DATABASE_URL="postgresql://aidev_user:MOT_DE_PASSE_POSTGRES_TRES_FORT@postgres:5432/aidev_db?schema=public"

# ── Backend NestJS ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Authentification JWT (Générer avec : openssl rand -base64 48)
JWT_SECRET="CLE_SECRETE_PRODUCTION_OBLIGATOIRE_MINIMUM_32_CARACTERES"
JWT_EXPIRES_IN="8h"
RECEIPT_SIGNING_SECRET="CLE_SECRETE_SIGNATURES_RECUS_MINIMUM_32_CARACTERES"

# Redis (obligatoire en production : files BullMQ et codes OTP de récupération)
REDIS_PASSWORD="MOT_DE_PASSE_REDIS_TRES_FORT"
REDIS_URL="redis://:MOT_DE_PASSE_REDIS_TRES_FORT@redis:6379"

# E-mails transactionnels Resend (reçus PDF, notifications, codes OTP)
RESEND_API_KEY="re_votre_cle_resend"
RESEND_FROM_EMAIL="AIDevClassroom <no-reply@ai-devclassroom.com>"

# Paystack (Clés LIVE de production uniquement)
PAYSTACK_SECRET_KEY="sk_live_votre_cle_secrete_live_paystack"
PAYSTACK_PUBLIC_KEY="pk_live_votre_cle_publique_live_paystack"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="https://classroom.votre-domaine.com/paiement/retour"
PAYSTACK_CURRENCY="XOF"
PAYSTACK_CHARGE_ENABLED="true"
PAYSTACK_CHARGE_PROVIDERS="mtn,orange,wave"
PAYSTACK_PENDING_RESERVE_MINUTES="120"
PAYSTACK_CHARGE_POLL_TIMEOUT_MS="180000"
PAYSTACK_CHARGE_POLL_INTERVAL_MS="5000"
PAYSTACK_FAILED_SHORT_CIRCUIT_MINUTES="15"
PAYSTACK_HTTP_TIMEOUT_MS="15000"

# CORS : Origine exacte du domaine configuré dans Coolify
FRONTEND_URL="https://classroom.votre-domaine.com"

# Swagger Documentation (désactivé en production)
SWAGGER_ENABLED=false

# ── Frontend Next.js ──────────────────────────────────────────────────────────
# URL interne sur le réseau Docker Coolify (les appels navigateur passent par /api)
NEXT_PUBLIC_API_URL="http://backend:3000/api/v1"
NEXT_PUBLIC_SITE_URL="https://classroom.votre-domaine.com"
NEXT_PUBLIC_PAYSTACK_CHARGE_ENABLED="1"
