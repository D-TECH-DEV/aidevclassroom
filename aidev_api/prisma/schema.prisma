generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum SprintStatus {
  DRAFT
  ACTIVE
  INACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum EnrollmentPlan {
  SINGLE
  DUO
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Student {
  id        Int         @id @default(autoincrement())
  firstName String      @map("first_name") @db.VarChar(100)
  lastName  String      @map("last_name") @db.VarChar(100)
  email     String      @unique @db.VarChar(190)
  phone     String      @db.VarChar(30)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  enrollments Enrollment[]

  @@index([email])
  @@index([phone])
  @@map("students")
}

model Sprint {
  id                Int          @id @default(autoincrement())
  name              String       @db.VarChar(150)
  slug              String       @unique @db.VarChar(190)
  description       String?      @db.Text
  priceXof          Int          @map("price_xof")
  minimumPaymentXof Int          @map("minimum_payment_xof")
  duoPriceXof       Int?         @map("duo_price_xof")
  duoMinimumPaymentXof Int?      @map("duo_minimum_payment_xof")
  startAt           DateTime     @map("start_at")
  endAt             DateTime     @map("end_at")
  capacity          Int?
  status            SprintStatus @default(DRAFT)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  enrollments       Enrollment[]

  @@index([status])
  @@map("sprints")
}

model Enrollment {
  id               Int              @id @default(autoincrement())
  studentId        Int              @map("student_id")
  sprintId         Int              @map("sprint_id")
  totalAmountXof   Int              @map("total_amount_xof")
  plan             EnrollmentPlan   @default(SINGLE)
  partnerFirstName String?          @map("partner_first_name") @db.VarChar(100)
  partnerLastName  String?          @map("partner_last_name") @db.VarChar(100)
  partnerPhone     String?          @map("partner_phone") @db.VarChar(30)
  partnerEmail     String?          @map("partner_email") @db.VarChar(190)
  status           EnrollmentStatus @default(PENDING)
  trackingTokenHash String          @map("tracking_token_hash") @db.VarChar(255)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sprint           Sprint           @relation(fields: [sprintId], references: [id], onDelete: Restrict)
  payments         Payment[]

  @@unique([studentId, sprintId])
  @@index([studentId])
  @@index([sprintId])
  @@index([status])
  @@index([partnerEmail])
  @@map("enrollments")
}

model Payment {
  id                Int           @id @default(autoincrement())
  enrollmentId      Int           @map("enrollment_id")
  amountXof         Int           @map("amount_xof")
  currency          String        @default("XOF") @db.VarChar(10)
  reference         String        @unique @db.VarChar(100)
  providerReference String?       @map("provider_reference") @db.VarChar(100)
  status            PaymentStatus @default(PENDING)
  authorizationUrl  String?       @map("authorization_url") @db.Text
  paidAt            DateTime?     @map("paid_at")
  providerResponse  Json?         @map("provider_response")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  enrollment        Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([status])
  @@index([createdAt])
  @@index([providerReference])
  @@map("payments")
}
