NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL="postgresql://USER:PASSWORD@<pg-host>:5432/aidev_db?schema=public"
JWT_SECRET="replace_with_a_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="1h"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="http://localhost:5173/payment/callback"
PAYSTACK_CURRENCY="XOF"
# Duree (minutes) pendant laquelle un paiement PENDING reserve le solde
# contre les initialisations concurrentes. Au-dela, la reservation expire.
PAYSTACK_PENDING_RESERVE_MINUTES="120"
# Canal Charge mobile money (mtn, orange, wave) : "true" pour debiter sans
# redirection, sinon l'ancien flux transaction/initialize + checkout reste.
# Desactive par defaut cote code ("false" si la variable est absente) : la
# charge ne part que si le flag vaut "true" ET qu'un provider est fourni.
PAYSTACK_CHARGE_ENABLED="true"
# Operateurs autorises pour la Charge (CSV).
PAYSTACK_CHARGE_PROVIDERS="mtn,orange,wave"
# Fenetre (ms) et intervalle (ms) de scrutation d'une charge cote serveur.
PAYSTACK_CHARGE_POLL_TIMEOUT_MS="180000"
PAYSTACK_CHARGE_POLL_INTERVAL_MS="5000"
# Court-circuit : un FAILED recent ne re-interroge pas Paystack (0 = desactive).
PAYSTACK_FAILED_SHORT_CIRCUIT_MINUTES="15"
# Delai max (ms) d'un appel HTTP Paystack avant abandon.
PAYSTACK_HTTP_TIMEOUT_MS="15000"
FRONTEND_URL="http://localhost:5173"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SWAGGER_ENABLED=true
