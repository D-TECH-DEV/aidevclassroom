# ==============================================================================
# Environnement PREPROD — Exemple de configuration (.env.preprod.example)
# Copier vers .env.preprod pour l'environnement de recette/staging
# ==============================================================================

COMPOSE_PROJECT_NAME=aidev-preprod

# ── Domaines et Ports ─────────────────────────────────────────────────────────
DOMAIN_NAME=preprod.votre-domaine.com
API_DOMAIN_NAME=api-preprod.votre-domaine.com
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Backend NestJS ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Base PostgreSQL externe dédiée à la préproduction sur le VPS
# Ne JAMAIS pointer vers la base de production !
DATABASE_URL="postgresql://preprod_user:MOT_DE_PASSE_SECURISE@IP_OU_DNS_PG_VPS:5432/aidev_preprod_db?schema=public"

# Authentification JWT (générer une clé aléatoire forte ≥ 32 caractères)
# Exemple de génération : openssl rand -base64 48
JWT_SECRET="CLE_SECRETE_PREPROD_A_GENERER_MINIMUM_32_CARACTERES"
JWT_EXPIRES_IN="12h"

# Paystack (Clés test ou compte sandbox de recette)
PAYSTACK_SECRET_KEY="sk_test_votre_cle_secrete_test_paystack"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL="https://preprod.votre-domaine.com/paiement/retour"
PAYSTACK_CURRENCY="XOF"
# Canal Charge mobile money direct (mtn, orange, wave), sans carte.
# Desactive par defaut cote code (ancien flux checkout) ; "true" debite sans
# redirection. Ne debite que si un provider mobile money est fourni.
PAYSTACK_CHARGE_ENABLED="true"
PAYSTACK_CHARGE_PROVIDERS="mtn,orange,wave"
# Fenetre (ms) et intervalle (ms) de scrutation d'une charge cote serveur.
PAYSTACK_CHARGE_POLL_TIMEOUT_MS="180000"
PAYSTACK_CHARGE_POLL_INTERVAL_MS="5000"
# Duree (minutes) de reservation d'un PENDING ; au-dela, ABANDONED.
PAYSTACK_PENDING_RESERVE_MINUTES="120"
# Court-circuit : un FAILED recent ne re-interroge pas Paystack (0 = desactive).
PAYSTACK_FAILED_SHORT_CIRCUIT_MINUTES="15"
# Delai max (ms) d'un appel HTTP Paystack avant abandon.
PAYSTACK_HTTP_TIMEOUT_MS="15000"

# CORS : Origine du frontend de préproduction
FRONTEND_URL="https://preprod.votre-domaine.com"

# Swagger Documentation (activé en préproduction pour validation des contrats)
SWAGGER_ENABLED=true

# ── Frontend Next.js ──────────────────────────────────────────────────────────
# URL publique de l'API de préproduction
NEXT_PUBLIC_API_URL="https://api-preprod.votre-domaine.com/api/v1"
# Bascule du parcours direct (charge mobile money, sans carte) : actif sauf
# "0" (repli ancien parcours checkout). Bascule auto si le back rend une
# authorizationUrl (charge desactivee cote serveur).
NEXT_PUBLIC_PAYSTACK_CHARGE_ENABLED="1"
